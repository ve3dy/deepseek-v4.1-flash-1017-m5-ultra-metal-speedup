     const m = try q.Model.load(gpa, init.io, args[1], false);
@@ -231,6 +232,80 @@ fn depths(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, prompt: []const u
     }
 }
 
+/// One load: a decode row after the prompt, timed whole with each pipeline left out in turn (DS_SKIP's keys), with
+/// every named pipeline left out ("!"), without barriers ("nobar") or on a serial encoder ("serial"); dispatches and
+/// barriers a call, and whether the row's logits equal the plain run's bit for bit. DS_SWEEP=k1,k2 times those only.
+fn sweep(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, prompt: []const u32) !void {
+    const m = try q.Model.load(gpa, io, dir, false);
+    defer m.deinit();
+    var scratch = try q.state.Scratch.init(gpa, m.device, 128);
+    defer scratch.deinit();
+    var cache = try q.state.Cache.init(gpa, m.device, prompt.len + 512);
+    defer cache.deinit();
+    var at: usize = 0;
+    while (at < prompt.len) : (at += 128) try q.forward.run(m, &scratch, &cache, prompt[at..@min(prompt.len, at + 128)], .last, null);
+    const base = cache.len;
+    const token = argmax(cache.logits.slice(u16, c.vocab));
+    const extra = [_][]const u8{ "rows", "indexed", "!", "nobar", "serial" };
+    var keys: std.ArrayList([]const u8) = .empty;
+    defer keys.deinit(gpa);
+    try keys.append(gpa, "");
+    const asked = std.mem.span(std.c.getenv("DS_SWEEP").?);
+    if (std.mem.eql(u8, asked, "1")) {
+        try keys.appendSlice(gpa, &q.kernels.names);
+        try keys.appendSlice(gpa, &extra);
+    } else {
+        var it = std.mem.splitScalar(u8, asked, ',');
+        while (it.next()) |k| try keys.append(gpa, k);
+    }
+    const plain = try gpa.alloc(u16, c.vocab);
+    defer gpa.free(plain);
+    var baseline: f64 = 0;
+    const reps = 48;
+    for (keys.items) |key| {
+        if (std.mem.eql(u8, key, "trace")) {
+            cache.len = base;
+            q.forward.trace = true;
+            try q.forward.run(m, &scratch, &cache, &.{token}, .last, null);
+            q.forward.trace = false;
+            std.debug.print("\n", .{});
+            continue;
+        }
+        q.forward.no_barriers = std.mem.eql(u8, key, "nobar");
+        q.forward.serial = std.mem.eql(u8, key, "serial");
+        q.forward.nobar_before = if (std.mem.startsWith(u8, key, "nb:")) key[3..] else null;
+        q.forward.skip = if (key.len == 0 or q.forward.no_barriers or q.forward.serial or q.forward.nobar_before != null) null else key;
+        for (0..4) |_| {
+            cache.len = base;
+            try q.forward.run(m, &scratch, &cache, &.{token}, .last, null);
+        }
+        q.forward.counted = .{ 0, 0 };
+        var best: f64 = std.math.inf(f64);
+        var sum: f64 = 0;
+        for (0..reps) |_| {
+            cache.len = base;
+            var t0: std.c.timespec = undefined;
+            var t1: std.c.timespec = undefined;
+            _ = std.c.clock_gettime(.MONOTONIC, &t0);
+            try q.forward.run(m, &scratch, &cache, &.{token}, .last, null);
+            _ = std.c.clock_gettime(.MONOTONIC, &t1);
+            const s = seconds(t0, t1);
+            best = @min(best, s);
+            sum += s;
+        }
+        const row = cache.logits.slice(u16, c.vocab);
+        if (key.len == 0) @memcpy(plain, row);
+        const equal = std.mem.eql(u16, plain, row);
+        const mean = sum * 1e3 / reps;
+        if (key.len == 0) baseline = mean;
+        std.debug.print("sweep {s:<24} {d:7.2} ms mean {d:7.2} best  saves {d:6.2}  dispatches {d} barriers {d}  logits {s}\n", .{ if (key.len == 0) "(none)" else key, mean, best * 1e3, baseline - mean, q.forward.counted[0] / reps, q.forward.counted[1] / reps, if (equal) "equal" else "differ" });
+    }
+    q.forward.no_barriers = false;
+    q.forward.serial = false;
+    q.forward.skip = null;
+    q.forward.nobar_before = null;
+}
+
 /// Four streams' windows of 1 to 6 rows in one forward a round against each alone: equal logits and drafts.
 fn shared(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, ids: []const u32, rounds: usize) !void {
     const k = q.backend.max_streams;
