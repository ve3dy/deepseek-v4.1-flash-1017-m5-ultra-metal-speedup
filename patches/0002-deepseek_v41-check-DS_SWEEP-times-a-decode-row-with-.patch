@@ -56,6 +56,36 @@ pub var timing: ?*[3]f64 = null;
 /// A check's ablation (DS_SKIP): dispatches of the pipeline of this name are left out, to time what each costs.
 pub var skip: ?[]const u8 = null;
 var skipping = false;
+/// A check's counts of dispatches and barriers encoded (the family's own helpers; the core's encoders are not seen).
+pub var counted: [2]usize = .{ 0, 0 };
+/// A check's timing of the barriers: none is encoded (the results are wrong; only the time means anything).
+pub var no_barriers = false;
+/// A check's timing of one fusion: no barrier before dispatches whose trace label starts with one of these (wrong
+/// results; the time a fusion of that dispatch into the one before could save).
+pub var nobar_before: ?[]const u8 = null;
+fn dropped() bool {
+    const list = nobar_before orelse return false;
+    var it = std.mem.splitScalar(u8, list, '+');
+    while (it.next()) |k| if (k.len > 0 and std.mem.startsWith(u8, current, k)) return true;
+    return false;
+}
+/// A check's serial encoder: every dispatch waits on the one before it, no barrier encoded (`with` pairs run in turn).
+pub var serial = false;
+fn kind() mtl.DispatchType {
+    return if (serial) .serial else .concurrent;
+}
+/// A check's trace of one call: each dispatch's pipeline, "|" where a barrier goes (stderr).
+pub var trace = false;
+fn note(comptime f: []const u8, a: anytype) void {
+    if (trace) std.debug.print(f, a);
+}
+/// A projection's trace label, formatted only when a check reads it (trace, nobar_before).
+fn labelled(comptime f: []const u8, a: anytype) []const u8 {
+    if (!trace and nobar_before == null) return "";
+    return std.fmt.bufPrint(&label, f, a) catch "";
+}
+var current: []const u8 = "";
+var label: [64]u8 = undefined;
 
 /// Whether DS_SKIP names `key`: a comma-separated list, or "!a,b" for everything but those.
 fn skips(key: []const u8) bool {
