+/// A check's GPU time by dispatch group: each barrier ends the encoder and opens the next one (serial, timestamped at
+/// its start and end, fenced after the one before), so every group between two barriers gets its own GPU time.
+pub var lat: ?*Lat = null;
+pub const Lat = struct {
+    pub const max = 2048; // two samples a group; a sample buffer holds 4,096
+    pass: mtl.counters.ComputePass,
+    samples: mtl.counters.SampleBuffer,
+    fence: mtl.counters.Fence,
+    n: usize = 0,
+    names: [max][48]u8 = undefined,
+    lens: [max]u8 = undefined,
+
+    pub fn init(device: mtl.Device) !Lat {
+        return .{ .pass = try mtl.counters.ComputePass.init(), .samples = try mtl.counters.SampleBuffer.init(device, 2 * max), .fence = try mtl.counters.Fence.init(device) };
+    }
+    pub fn deinit(l: *Lat) void {
+        l.pass.deinit();
+        l.samples.deinit();
+        l.fence.deinit();
+    }
+    /// The group's name: its first dispatch's label.
+    pub fn name(l: *const Lat, i: usize) []const u8 {
+        return l.names[i][0..l.lens[i]];
+    }
+    fn cut(l: *Lat, x: Enc) void {
+        if (l.n >= max) return;
+        l.fence.update(x.ep.*);
+        x.ep.*.end();
+        const e = l.pass.compute(x.cbp.*, l.samples, 2 * l.n, 2 * l.n + 1) catch unreachable;
+        l.fence.waitCompute(e);
+        x.ep.* = e;
+        const len = @min(current.len, 48);
+        @memcpy(l.names[l.n][0..len], current[0..len]);
+        l.lens[l.n] = @intCast(len);
+        l.n += 1;
+    }
+};
