+    const cold = std.c.getenv("DS_COLD") != null;
+    const thrash: ?mtl.Pipeline = if (cold) try mtl.Pipeline.init(m.device, lib, "ds_exp_thrash", false) else null;
+    const junk: ?mtl.Buffer = if (cold) try m.device.buffer(256 << 20, mtl.ResourceOptions.private) else null;
+    defer if (junk) |j| j.deinit();
+    var thrash_us: f64 = 0;
+    if (thrash) |tp| {
+        var best: f64 = std.math.inf(f64);
+        for (0..3) |_| {
+            const cb = m.queue.commandBufferUnretained();
+            const e = cb.compute(.concurrent);
+            for (0..40) |_| encodeThrash(e, tp, junk.?, s);
+            e.end();
+            cb.commit();
+            cb.wait();
+            best = @min(best, cb.gpuSeconds());
+        }
+        thrash_us = best / 40 * 1e6;
+        std.debug.print("rx cold: a 256 MB read takes {d:.1} us, taken off each\n", .{thrash_us});
+    }
+    for (vars.items) |v| {
+        const alt: ?mtl.Pipeline = if (v.len == 0) null else try mtl.Pipeline.init(m.device, lib, v, false);
+        var sum: f64 = 0;
+        var count: usize = 0;
+        for (0..r.n) |i| {
+            if (!r.items[i].ok or !std.mem.eql(u8, r.name(i), name)) continue;
+            const orig = r.items[i].pipe;
+            if (alt) |p| r.items[i].pipe = p;
+            defer r.items[i].pipe = orig;
+            var best: f64 = std.math.inf(f64);
+            for (0..3) |_| {
+                const cb = m.queue.commandBufferUnretained();
+                const e = cb.compute(.concurrent);
+                for (0..40) |_| {
+                    if (thrash) |tp| encodeThrash(e, tp, junk.?, s);
+                    e.barrier();
+                    r.encode(i, e);
+                }
+                e.end();
+                cb.commit();
+                cb.wait();
+                best = @min(best, cb.gpuSeconds());
+            }
+            sum += best / 40 * 1e6 - thrash_us;
+            count += 1;
+        }
+        std.debug.print("rx {s:<20} {s:<28} {d:7.2} us a dispatch over {d}\n", .{ name, if (v.len == 0) "(its own)" else v, sum / @as(f64, @floatFromInt(@max(count, 1))), count });
+    }
+}
+
+fn encodeThrash(e: mtl.ComputeEncoder, p: mtl.Pipeline, junk: mtl.Buffer, s: *q.state.Scratch) void {
+    e.barrier();
+    e.setPipeline(p);
+    e.setBuffer(junk, 0, 0);
+    e.setBuffer(s.counts, 0, 1);
+    const n: u32 = @intCast((256 << 20) / 16);
+    e.setBytes(std.mem.asBytes(&n), 2);
+    e.dispatchThreads(mtl.Size.of(8192 * 256, 1, 1), mtl.Size.of(256, 1, 1));
+}
+
+/// One decode row recorded (forward.Rec), then each recorded dispatch alone, 40 times in a command buffer with a
+/// barrier before each: its latency as a dependent step, summed by label. Last in a sweep: the replays write the
+/// scratch and cache again.
+fn replay(gpa: std.mem.Allocator, m: *q.Model, s: *q.state.Scratch, cache: *q.state.Cache, token: u32) !void {
+    const r = try gpa.create(q.forward.Rec);
+    defer gpa.destroy(r);
+    r.* = .{};
+    q.forward.rec = r;
+    try q.forward.run(m, s, cache, &.{token}, .last, null);
+    q.forward.rec = null;
+    const reps = 40;
+    var names: std.StringArrayHashMapUnmanaged([2]f64) = .empty;
+    defer names.deinit(gpa);
+    var total: f64 = 0;
+    for (0..r.n) |i| {
+        if (!r.items[i].ok) continue;
+        var best: f64 = std.math.inf(f64);
+        for (0..3) |_| {
+            const cb = m.queue.commandBufferUnretained();
+            const e = cb.compute(.concurrent);
+            for (0..reps) |_| {
+                e.barrier();
+                r.encode(i, e);
+            }
+            e.end();
+            cb.commit();
+            cb.wait();
+            best = @min(best, cb.gpuSeconds());
+        }
+        const us = best / reps * 1e6;
+        total += us;
+        const g = try names.getOrPut(gpa, r.name(i));
+        if (!g.found_existing) g.value_ptr.* = .{ 0, 0 };
+        g.value_ptr[0] += us;
+        g.value_ptr[1] += 1;
+    }
+    const Row = struct { name: []const u8, us: f64, count: f64 };
+    var rows: std.ArrayList(Row) = .empty;
+    defer rows.deinit(gpa);
+    var it = names.iterator();
+    while (it.next()) |e| try rows.append(gpa, .{ .name = e.key_ptr.*, .us = e.value_ptr[0], .count = e.value_ptr[1] });
+    std.mem.sort(Row, rows.items, {}, struct {
+        fn lt(_: void, a: Row, b: Row) bool {
+            return a.us > b.us;
+        }
+    }.lt);
+    std.debug.print("replay {d} dispatches recorded: {d:.0} us as dependent steps\n", .{ r.n, total });
+    for (rows.items) |x| std.debug.print("replay {s:<28} {d:7.0} us  {d:4.0} dispatches  {d:6.1} us each\n", .{ x.name, x.us, x.count, x.us / x.count });
+}
+
+/// One decode row with every barrier turned into an encoder boundary (forward.Lat): GPU µs by dispatch group summed
+/// by its first dispatch's label, the time between groups, and the call's total; the best of 5 calls a group.
+fn latency(gpa: std.mem.Allocator, m: *q.Model, s: *q.state.Scratch, cache: *q.state.Cache, token: u32) !void {
+    var l = try q.forward.Lat.init(m.device);
+    defer l.deinit();
+    const base = cache.len;
+    var best: [q.forward.Lat.max]f64 = @splat(std.math.inf(f64));
+    var gap_best: [q.forward.Lat.max]f64 = @splat(std.math.inf(f64));
+    var n: usize = 0;
+    try q.forward.run(m, s, cache, &.{token}, .last, null);
+    const plain = try gpa.dupe(u16, cache.logits.slice(u16, c.vocab));
+    defer gpa.free(plain);
+    for (0..6) |rep| {
+        l.n = 0;
+        cache.len = base;
+        const c0 = mtl.counters.sampleClocks(m.device);
+        q.forward.lat = &l;
+        defer q.forward.lat = null;
+        try q.forward.run(m, s, cache, &.{token}, .last, null);
+        q.forward.lat = null;
+        if (!std.mem.eql(u16, plain, cache.logits.slice(u16, c.vocab))) std.debug.print("lat: logits differ from the plain call's (a group lost its state)\n", .{});
+        const c1 = mtl.counters.sampleClocks(m.device);
+        const ns_tick = @as(f64, @floatFromInt(c1.cpu - c0.cpu)) / @as(f64, @floatFromInt(c1.gpu - c0.gpu));
+        n = l.n;
+        if (rep == 0) continue; // pipelines warm
+        const r = try l.samples.resolveCompleted(2 * n);
+        defer r.deinit();
+        const t = r.values();
+        for (0..n) |i| {
+            const d = @as(f64, @floatFromInt(t[2 * i + 1].timestamp -% t[2 * i].timestamp)) * ns_tick / 1e3;
+            best[i] = @min(best[i], d);
+            if (i + 1 < n) gap_best[i] = @min(gap_best[i], @as(f64, @floatFromInt(t[2 * i + 2].timestamp -% t[2 * i + 1].timestamp)) * ns_tick / 1e3);
+        }
+    }
+    var names: std.StringArrayHashMapUnmanaged([2]f64) = .empty;
+    defer names.deinit(gpa);
+    var busy: f64 = 0;
+    var gaps: f64 = 0;
+    for (0..n) |i| {
+        const g = try names.getOrPut(gpa, l.name(i));
+        if (!g.found_existing) g.value_ptr.* = .{ 0, 0 };
+        g.value_ptr[0] += best[i];
+        g.value_ptr[1] += 1;
+        busy += best[i];
+        if (i + 1 < n) gaps += gap_best[i];
+    }
+    const Row = struct { name: []const u8, us: f64, count: f64 };
+    var rows: std.ArrayList(Row) = .empty;
+    defer rows.deinit(gpa);
+    var it = names.iterator();
+    while (it.next()) |e| try rows.append(gpa, .{ .name = e.key_ptr.*, .us = e.value_ptr[0], .count = e.value_ptr[1] });
+    std.mem.sort(Row, rows.items, {}, struct {
+        fn lt(_: void, a: Row, b: Row) bool {
+            return a.us > b.us;
+        }
+    }.lt);
+    std.debug.print("lat groups {d}: busy {d:.0} us, between groups {d:.0} us\n", .{ n, busy, gaps });
+    for (rows.items) |r| std.debug.print("lat {s:<28} {d:7.0} us  {d:4.0} groups  {d:6.1} us each\n", .{ r.name, r.us, r.count, r.us / r.count });
 }
 
