+/// The routed experts' row kernel alone, on a decode row's six picks (the scratch's last route): one matrix of each of
+/// the 40 layers in turn (1-2 GB, past the caches), with a barrier before each dispatch and without; µs and GB/s.
+fn kbench(m: *q.Model, s: *q.state.Scratch) !void {
+    const rp = @import("tensorfold").row_projection;
+    for ([_][]const u8{ "w1", "w2" }) |name| {
+        const down = std.mem.eql(u8, name, "w2");
+        for ([_]bool{ true, false }) |barriers| {
+            var best: f64 = std.math.inf(f64);
+            var bytes: usize = 0;
+            for (0..4) |_| {
+                bytes = 0;
+                const cb = m.queue.commandBufferUnretained();
+                const e = cb.compute(.concurrent);
+                for (&m.weights.layers) |*l| {
+                    const x = if (down) l.moe.w2 else l.moe.w1;
+                    const call = try rp.callIndexed(&m.kernels.rows, x, c.topk, false);
+                    const w = x.one;
+                    bytes += c.topk * (w.n * w.k * w.bits / 8 + w.n * (w.k / w.group) * 4);
+                    e.setPipeline(call.pipeline);
+                    e.setBuffer(if (down) s.act else s.normed, 0, 0);
+                    e.setBuffer(w.w, w.w_off, 1);
+                    e.setBuffer(w.scales, w.s_off, 2);
+                    e.setBuffer(w.biases, w.b_off, 3);
+                    e.setBytes(std.mem.asBytes(&call.dims), 4);
+                    e.setBuffer(if (down) s.experts else s.gate, 0, 5);
+                    e.setBuffer(s.route_pick, 0, 6);
+                    if (barriers) e.barrier();
+                    e.dispatchThreads(mtl.Size.of(call.groups * call.threads, call.slots, 1), mtl.Size.of(call.threads, 1, 1));
+                }
+                e.end();
+                cb.commit();
+                cb.wait();
+                best = @min(best, cb.gpuSeconds());
+            }
+            std.debug.print("kbench {s} x6 over 40 layers {s}: {d:.1} us a layer, {d:.0} GB/s ({d:.2} GB)\n", .{ name, if (barriers) "barriers" else "overlapped", best / 40 * 1e6, @as(f64, @floatFromInt(bytes)) / best / 1e9, @as(f64, @floatFromInt(bytes)) / 1e9 });
+        }
+    }
+}
+
 /// Four streams' windows of 1 to 6 rows in one forward a round against each alone: equal logits and drafts.
 fn shared(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, ids: []const u32, rounds: usize) !void {
     const k = q.backend.max_streams;
